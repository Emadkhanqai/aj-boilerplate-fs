<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AjBoilerplate.Domain\AjBoilerplate.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <!-- Abstractions only (no logging provider, no configuration binding): the Application layer
         may log, but must never own the logging pipeline. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <!-- Needed only to detect the SQL Server deadlock/unique-constraint error numbers inside a
         caught DbUpdateException, so a lost race can be translated into a clean idempotent/409
         result instead of propagating as a raw 500 (see Persistence/). Version pinned to match what
         EntityFrameworkCore.SqlServer already pulls in transitively via the Infrastructure project,
         so no version actually changes at runtime. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Microsoft.Data.SqlClient 6.1.1 pulls in System.Security.Cryptography.Pkcs 9.0.4, which carries
         advisories GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate); with warnings as errors
         that fails every restore. Pinned directly so the patched version wins; drop it once SqlClient
         itself depends on a patched Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
