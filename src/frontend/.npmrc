# Turns the `engines` field in package.json from advice into a gate.
#
# Without this, npm prints an EBADENGINE *warning* and installs anyway — so a developer on the
# wrong Node major gets a scrolled-past yellow line and a node_modules built by a toolchain CI
# never uses. That is precisely the "green in CI, broken on my machine" asymmetry that `.nvmrc`
# and `engines` exist to close, and closing it needs the install to actually fail.
#
# Verified both directions before committing to this: with the declared range it installs
# cleanly (none of the ~721 transitive packages declaring `engines.node` rejects Node 22), and
# with an out-of-range engine npm exits non-zero on EBADENGINE rather than merely warning.
engine-strict=true
