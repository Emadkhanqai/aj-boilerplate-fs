  "components": {
    "schemas": {
      "AcknowledgeFeaturesRequest": {
        "type": "object",
        "properties": {
          "featureIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The announcements to mark as seen — normally every id the last lookup returned, sent in one\nrequest when the user closes the popup. Idempotent: ids already acknowledged are silently\nskipped, and an empty array is an accepted no-op.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Dismissal request body."
      },
      "CreateItemRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Required, 1–200 characters.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Optional, up to 2000 characters.",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Optional; defaults to `Draft` when omitted.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Create-item request body."
      },
      "FeatureAnnouncementResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Send this back to `POST /api/v1/features/ack` to dismiss it.",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "description": "Stable machine identifier, e.g. `search-v2`. Not for display.",
            "nullable": true
          },
          "titleEn": {
            "type": "string",
            "description": "English title.",
            "nullable": true
          },
          "titleAr": {
            "type": "string",
            "description": "Arabic title; null means \"fall back to the English title\".",
            "nullable": true
          },
          "bodyEn": {
            "type": "string",
            "description": "English body.",
            "nullable": true
          },
          "bodyAr": {
            "type": "string",
            "description": "Arabic body; null means \"fall back to the English body\".",
            "nullable": true
          },
          "displayOrder": {
            "type": "integer",
            "description": "Presentation order when several are pending; lower shows first.",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "description": "When the announcement was created, UTC.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "A \"what's new\" announcement the current user has not dismissed yet. The only shape that crosses\nthe API boundary for announcements; the EF entity is never serialised."
      },
      "ItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Server-assigned identifier.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Display name, 1–200 characters.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Optional free text, up to 2000 characters.",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "One of `Draft`, `Active`, `Archived`.",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "When the item was created, UTC.",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "When the item was last modified, UTC; null if never modified.",
            "format": "date-time",
            "nullable": true
          },
          "rowVersion": {
            "type": "string",
