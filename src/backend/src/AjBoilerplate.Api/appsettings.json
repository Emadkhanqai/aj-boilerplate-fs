{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=AppDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": ""
  },
  "Cloud": {
    "Provider": "gcp",
    "Gcp": {
      "ProjectId": ""
    },
    "Azure": {
      "KeyVaultUri": ""
    }
  },
  "Auth": {
    "Mode": "gateway"
  },
  "Keycloak": {
    "Authority": "",
    "ClientId": "",
    "JwksUri": "",
    "ValidIssuer": "",
    "RequireHttpsMetadata": true,
    "AllowDiscoveryFallback": false,
    "HonourRealmRoles": false
  },
  "Idempotency": {
    "Enabled": true,
    "MaxResponseBytes": 262144,
    "RetentionHours": 24
  },
  "Storage": {
    "LocalRoot": "App_Data/storage",
    "Gcp": {
      "Bucket": ""
    },
    "Azure": {
      "Container": ""
    }
  },
  "Features": {},
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "no-reply@example.invalid",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30
  },
  "EntityIdObfuscation": {
    "EncryptionKey": ""
  }
}
