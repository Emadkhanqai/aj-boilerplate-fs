{
  "realm": "aj-boilerplate",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "displayName": "aj-boilerplate (LOCAL DEV-ONLY realm)",
  "clients": [
    {
      "clientId": "aj-boilerplate-app",
      "name": "App (what the Auth service exchanges to; azp the API checks)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${LOCAL_APP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "flat roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "aj-boilerplate-app",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "aj-boilerplate-entra-sim",
      "name": "Plays Entra ID for local sign-in (DEV-ONLY)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${LOCAL_ENTRA_SIM_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:${WEB_PORT}/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience: the app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "aj-boilerplate-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "optionalClientScopes": [
        "offline_access",
        "User.Read"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic"
      ]
    },
    {
      "clientId": "aj-boilerplate-admin",
      "name": "Admin REST client of the Auth service (DEV-ONLY)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${LOCAL_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "roles": {
    "client": {
      "aj-boilerplate-app": [
        {
          "name": "admin",
          "description": "Seat. Composite: also grants items:read, items:write, admin:manage",
          "composite": true,
          "composites": {
            "client": {
              "aj-boilerplate-app": [
                "items:read",
                "items:write",
                "admin:manage"
              ]
            }
          }
        },
        {
          "name": "editor",
          "description": "Seat. Composite: also grants items:read, items:write",
          "composite": true,
          "composites": {
            "client": {
              "aj-boilerplate-app": [
                "items:read",
                "items:write"
              ]
            }
          }
        },
        {
          "name": "viewer",
          "description": "Seat. Composite: also grants items:read",
          "composite": true,
          "composites": {
            "client": {
              "aj-boilerplate-app": [
                "items:read"
              ]
            }
          }
        },
        {
          "name": "items:read",
          "description": "Permission: read items"
        },
        {
          "name": "items:write",
          "description": "Permission: create and change items"
        },
        {
          "name": "admin:manage",
          "description": "Permission: administration"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "app",
      "path": "/app",
      "subGroups": [
        {
          "name": "admins",
          "path": "/app/admins",
          "clientRoles": {
            "aj-boilerplate-app": [
              "admin"
            ]
          }
        },
        {
          "name": "editors",
          "path": "/app/editors",
          "clientRoles": {
            "aj-boilerplate-app": [
              "editor"
            ]
          }
        },
        {
          "name": "viewers",
          "path": "/app/viewers",
          "clientRoles": {
            "aj-boilerplate-app": [
              "viewer"
            ]
          }
        }
      ]
    }
  ],
