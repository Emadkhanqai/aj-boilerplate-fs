  "paths": {
    "/api/v1/features/unack": {
      "get": {
        "tags": [
          "Features"
        ],
        "summary": "Active announcements the current user has not acknowledged yet whose page list matches\npath — or whose page list is empty, which matches every route. Returns an\nempty array when there is nothing to show.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "description": "The path the client is currently on, e.g. `/reports/monthly`. Any query string or\nfragment is ignored, and `.`/`..` segments are resolved before matching, so a path\nis always compared as it actually resolves. Defaults to `/` when omitted.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FeatureAnnouncementResponse"
                      }
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "nullable": true
                    },
                    "statusCode": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string",
                      "nullable": true
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "traceId": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "default": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "nullable": true
                    },
                    "code": {
                      "type": "string",
                      "nullable": true
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "traceId": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "default": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "nullable": true
                    },
                    "code": {
                      "type": "string",
                      "nullable": true
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "traceId": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/features/ack": {
      "post": {
        "tags": [
          "Features"
        ],
        "summary": "Marks one or more announcements as seen by the current user. Idempotent — already-acknowledged\nids are silently skipped, so dismissing twice is a success, not a conflict. Call it on every\nclose path (the confirm button, the close icon, Escape).",
        "requestBody": {
          "description": "The ids to acknowledge. An empty array is an accepted no-op.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeFeaturesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeFeaturesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeFeaturesRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "default": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "nullable": true
                    },
                    "code": {
                      "type": "string",
                      "nullable": true
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "traceId": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "default": false
                    },
                    "message": {
                      "type": "string",
                      "nullable": true
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "nullable": true
                    },
                    "code": {
                      "type": "string",
                      "nullable": true
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "traceId": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
