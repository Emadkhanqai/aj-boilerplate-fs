# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# Local SQL Server container password (docker-compose.yml). Use a strong, unique value.
MSSQL_SA_PASSWORD=

# gcp | azure — selects the secrets provider (and file storage) at the composition root. Authentication
# does not branch on the cloud: the API validates Keycloak tokens on both.
CLOUD_PROVIDER=gcp
