<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AjBoilerplate.Auth</RootNamespace>
    <!-- MUST stay false. Microsoft.Data.SqlClient needs ICU and, in invariant mode, throws on the FIRST
         connection attempt rather than at start-up: the instance comes up healthy, then fails every SQL call. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Deliberately NOT a reference to Domain / Application / Infrastructure / Contracts / Api: the Auth
       service deploys on its own. AjBoilerplate.ArchitectureTests fails the build if that changes. -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- TRANSITIVE PIN, not used by this project's own code. Microsoft.EntityFrameworkCore.SqlServer 10.0.3 ->
         Microsoft.Data.SqlClient resolves System.Security.Cryptography.Pkcs 9.0.4, which carries
         GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. NuGetAudit raises NU1902/NU1903, which
         TreatWarningsAsErrors turns into a failed restore. Drop it once SqlClient itself references a fixed Pkcs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AjBoilerplate.Auth.Tests" />
  </ItemGroup>

</Project>
