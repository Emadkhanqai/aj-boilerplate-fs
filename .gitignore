# ---------------------------------------------------------------------------
# DO NOT IGNORE `.claude/`
#
# The agentic harness (settings, hooks, commands, standards, agents) ships
# committed so every developer and every CI run gets identical guardrails.
# Never add `.claude/` — or any path inside it — to this file.
# The only exception is `.claude/settings.local.json`, which is per-developer
# machine state and is listed below.
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---- Secrets and local configuration (never commit these) ----
.env
.env.*
!.env.example
*.env.local
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12
*.pem
!**/testdata/*.pem
credentials.json
gha-creds-*.json

# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
project.lock.json
project.fragment.lock.json

# .NET design-time BuildHost quirk on macOS (directories literally named "bin\Debug")
bin\\Debug/
**/BuildHost-*/

# ---- .NET test and coverage output ----
TestResults/
[Tt]est[Rr]esult*/
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.trx
*.coverage
*.coveragexml
*.received.*
BenchmarkDotNet.Artifacts/

