# =============================================================================
# .env.example — every environment variable this repository reads, in one place.
#
# Copy to `.env` and fill in what you need:      cp .env.example .env
# `.env` is gitignored (`.env` and `.env.*` are blocked, `.env.example` is the
# single negated exception) and must never be committed.
#
# THERE IS NOT A SINGLE REAL VALUE IN THIS FILE, AND THERE NEVER MAY BE.
# Placeholders are written as `<angle-bracketed-description>` or left blank so
# that `.claude/hooks/secret-scan.sh` and the Gitleaks CI gate recognise them as
# placeholders rather than leaks. If you add a variable here, add a placeholder,
# not an example that happens to work.
#
# HOW .NET READS THESE
# `ConnectionStrings__Default` is the environment form of the `ConnectionStrings:Default`
# key in `appsettings.json`: a double underscore is the section separator, because a
# colon is not a legal environment-variable character on every platform. Anything in
# `appsettings.json` can be overridden this way. Configuration precedence, lowest to
# highest: appsettings.json → appsettings.{Environment}.json → the cloud secret store
# (see `AddCloudSecrets`) → environment variables → command-line arguments.
#
# WHAT BELONGS IN A DEPLOYED ENVIRONMENT INSTEAD
# Nothing marked SECRET below should reach a deployed environment through a `.env`
# file. Deployed environments read secrets from GCP Secret Manager or Azure Key Vault,
# loaded into configuration at boot by `AddCloudSecrets()`. A `.env` file is a
# local-development and local-Docker mechanism only.
#
# Sections:
#   1. Docker Compose (root `docker-compose.yml`)
#   2. Backend — core
#   3. Backend — cloud provider and secret store
#   4. Backend — authentication and authorisation
#   5. Backend — HTTP behaviour (CORS, rate limiting, proxies)
#   6. Backend — observability
#   7. Backend — email
#   8. Backend — EF Core tooling
#   9. Frontend — runtime configuration
#  10. Local developer tooling (SonarQube gate, hook opt-outs)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DOCKER COMPOSE — the root `docker-compose.yml`
# -----------------------------------------------------------------------------

# REQUIRED to run any compose stack in this repository.
# The `sa` password for the local SQL Server container. SQL Server enforces its own
# complexity rules and the container will refuse to start with a weak value: at least
# 8 characters, from at least three of upper case, lower case, digits, and symbols.
# Local-only, throwaway, and never reused anywhere real.
MSSQL_SA_PASSWORD=<local-only-strong-password>

# OPTIONAL. Database created and used by the local stack. Defaults to `AppDb`.
DB_NAME=AppDb

# OPTIONAL. Host ports the root compose stack publishes. Change them if something
# else on your machine already owns one.
API_PORT=8080
WEB_PORT=4200
DB_PORT=1433
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# 2. BACKEND — CORE
# -----------------------------------------------------------------------------

# REQUIRED in every environment except Development.
# SQL Server connection string. `AddInfrastructure` throws at startup if this is unset
# outside Development, rather than silently falling back to a localhost string that
# points at nothing in a deployed environment.
# SECRET when it carries a password — supply it from the cloud secret store, not here.
# The root compose stack sets this itself for the `api` container; you only need it when
# running the API directly on your machine with `dotnet run`.
ConnectionStrings__Default=<Server=localhost,1433;Database=AppDb;User Id=sa;Password=...;TrustServerCertificate=True;>

# OPTIONAL, but STRONGLY RECOMMENDED outside Development.
# Redis connection string. When blank, the application registers an in-memory distributed
# cache: correct for a single Development instance, and quietly wrong the moment there is
# more than one instance, because the cache stops being shared. `Program.cs` logs a warning
# at startup when this is blank outside Development.
ConnectionStrings__Redis=<host:6379>

# OPTIONAL. `Development` | `Staging` | `Production`. Defaults to `Production` when unset.
# Development is load-bearing: it is what enables Swagger UI, relaxes the connection-string
# guard above, and disables HSTS.
ASPNETCORE_ENVIRONMENT=Development

# OPTIONAL. The addresses Kestrel binds. The container image already sets
# `http://+:8080`; set this only when running outside the container on a busy machine.
ASPNETCORE_URLS=http://+:8080

# OPTIONAL. Minimum log level. Any `appsettings.json` logging key can be overridden this
# way; these two are the ones people actually reach for.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning


# -----------------------------------------------------------------------------
# 3. BACKEND — CLOUD PROVIDER AND SECRET STORE
# -----------------------------------------------------------------------------

# REQUIRED in a deployed environment; defaults to `gcp` locally.
# `gcp` | `azure`. Selects the secrets provider and the authentication issuer at the
# composition root, and selects which `infra/` tree `deploy.yml` applies. An unrecognised
# value throws at startup on purpose — see `CloudOptions.Resolve()`. This is the same
# switch described in ADR-0002.
CLOUD_PROVIDER=gcp

# OPTIONAL. Equivalent to CLOUD_PROVIDER, as ordinary configuration rather than as a
# well-known environment variable. CLOUD_PROVIDER wins when both are set. Set one, not both.
# Cloud__Provider=gcp

# OPTIONAL (REQUIRED when CLOUD_PROVIDER=gcp and you want Secret Manager).
# The Google Cloud project whose Secret Manager holds this application's secrets. Blank
# disables the secrets integration entirely, which is the correct local/test/offline state.
Cloud__Gcp__ProjectId=<your-gcp-project-id>

# OPTIONAL (REQUIRED when CLOUD_PROVIDER=azure and you want Key Vault).
# e.g. https://<your-vault-name>.vault.azure.net/ — blank disables the integration.
Cloud__Azure__KeyVaultUri=<https://your-vault-name.vault.azure.net/>


# -----------------------------------------------------------------------------
# 4. BACKEND — AUTHENTICATION AND AUTHORISATION
#
# Two independent concerns, deliberately:
#   · AUTHENTICATION (who are you) is the one identity concern that differs per cloud.
#   · AUTHORISATION (what may you do) is Keycloak on both clouds and never branches.
#
# The recommended topology is Keycloak issuing the tokens this API accepts, federating
# upstream to the cloud IdP. In that topology fill in section 4a and leave 4b blank.
# Section 4b exists for the simpler topology where the API validates the cloud IdP's
# tokens directly.
# -----------------------------------------------------------------------------

# --- 4a. Keycloak (recommended) ---

# REQUIRED for Keycloak validation: either `Keycloak__JwksUri` or `Keycloak__Authority`,
# plus `Keycloak__ValidIssuer`. With none of them set, Keycloak validation is simply not
# configured and the API falls back to section 4b.
# Base URL used for OIDC discovery when JwksUri is not set.
Keycloak__Authority=<https://keycloak.example.com/realms/your-realm>

# OPTIONAL. The realm name.
Keycloak__Realm=<your-realm>

# REQUIRED when roles are read from `resource_access`.
# This API's client id. Used to select the right `resource_access` entry and to enforce
# the `azp` check — a shared realm issues tokens to other applications too.
Keycloak__ClientId=<your-api-client-id>

# SECRET. OPTIONAL — only needed for confidential-client flows.
# NEVER set this in a committed file. Supply it from the cloud secret store.
Keycloak__ClientSecret=

# OPTIONAL but PREFERRED over discovery. Explicit JWKS endpoint.
Keycloak__JwksUri=<https://keycloak.example.com/realms/your-realm/protocol/openid-connect/certs>

# REQUIRED for Keycloak validation. The exact `iss` value tokens carry.
# Separate from Authority on purpose: a Keycloak behind a gateway serves discovery at the
# gateway address while stamping its own internal URL into `iss`. Validating the issuer
# against the gateway address would reject every real token.
Keycloak__ValidIssuer=<https://keycloak.internal/realms/your-realm>

# OPTIONAL. Defaults to true and should stay true everywhere real. Setting it false
# disables transport authentication of the metadata endpoint; only an isolated local or
# QA host with no TLS has any business doing that.
Keycloak__RequireHttpsMetadata=true

# --- 4b. Upstream cloud identity provider (used when Keycloak is not configured) ---

# Used when CLOUD_PROVIDER=gcp.
Authentication__GoogleCloudIdentity__Authority=<https://accounts.google.com>
# The audience (this API's identifier) tokens must be issued for. Validating it is what
# stops a token minted for a DIFFERENT application in the same tenant being accepted here.
Authentication__GoogleCloudIdentity__Audience=<your-api-audience>

# Used when CLOUD_PROVIDER=azure.
Authentication__EntraId__Authority=<https://login.microsoftonline.com/your-tenant-id/v2.0>
Authentication__EntraId__Audience=<api://your-api-client-id>

# --- 4c. Opaque entity identifiers ---

# SECRET. REQUIRED in every deployed environment.
# Key material for the AES codec that turns internal integer ids into opaque public ones.
# Rotating it invalidates every id already handed out, so treat it as long-lived and store
# it in the cloud secret store. A high-entropy random string; never reuse the local value
# in any deployed environment.
EntityIdObfuscation__EncryptionKey=<random-high-entropy-string-unique-per-environment>


# -----------------------------------------------------------------------------
# 5. BACKEND — HTTP BEHAVIOUR
# -----------------------------------------------------------------------------

# REQUIRED once a browser calls the API from a different origin.
# Zero-indexed array. `Cors:AllowedOrigins` is an array in appsettings.json, and the
# environment form of an array element is its index. Add `__1`, `__2`, … as needed.
# The root compose stack does not need this: nginx proxies `/api` same-origin.
Cors__AllowedOrigins__0=http://localhost:4200

# OPTIONAL. Global fixed-window rate limit. Over quota returns 429.
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

# OPTIONAL, and OFF BY DEFAULT.
# Enable ONLY when the API genuinely sits behind a reverse proxy or load balancer you
# control. It makes the application trust `X-Forwarded-For`, which is a client-supplied
# header; trusting it without a proxy in front lets any caller spoof their own IP and
# escape the rate limiter's per-IP partition.
ForwardedHeaders__Enabled=false
ForwardedHeaders__ForwardLimit=1
# Zero-indexed arrays, as above. Restrict to the proxies you actually run.
# ForwardedHeaders__KnownProxies__0=<proxy-ip>
# ForwardedHeaders__KnownNetworks__0=<cidr>

# OPTIONAL. Host header filtering. `*` is the shipped default and is only appropriate
# where something in front of the API already terminates and validates the host.
AllowedHosts=*


# -----------------------------------------------------------------------------
# 6. BACKEND — OBSERVABILITY
# -----------------------------------------------------------------------------

# OPTIONAL. OpenTelemetry OTLP collector endpoint. The exporter attaches only when this
# is set; blank means traces and metrics are collected in-process and go nowhere, which
# is the right default for local development.
Otlp__Endpoint=<http://localhost:4317>


# -----------------------------------------------------------------------------
# 7. BACKEND — EMAIL
# -----------------------------------------------------------------------------

# OPTIONAL. When `Smtp__Host` is blank the application registers a logging no-op sender,
# so nothing is sent and nothing fails. Set the host to switch to real SMTP — that single
# key is the switch.
Smtp__Host=
Smtp__Port=587
Smtp__From=no-reply@example.invalid
Smtp__Username=
# SECRET. Supply from the cloud secret store in any deployed environment.
Smtp__Password=
Smtp__TimeoutSeconds=30


# -----------------------------------------------------------------------------
# 8. BACKEND — EF CORE TOOLING
# -----------------------------------------------------------------------------

# REQUIRED for `dotnet ef database update` and for the compose `migrate` service.
# The design-time factory (`AppDbContextFactory`) reads THIS variable, not
# `ConnectionStrings__Default` — the tooling never starts the application, so it never
# reaches Program.cs or DI. Getting these two confused is the single most common reason
# `dotnet ef database update` writes to the wrong database.
# `dotnet ef migrations add` never connects, so it does not need this set.
APP_DB_CONNECTION=<Server=localhost,1433;Database=AppDb;User Id=sa;Password=...;TrustServerCertificate=True;>


# -----------------------------------------------------------------------------
# 9. FRONTEND — RUNTIME CONFIGURATION
#
# These are read at CONTAINER START, not at build time. `docker/40-env.sh` rewrites
# `env.js` from them before nginx begins serving, so one built image can be promoted
# through every environment. They do not apply to `nx serve`, which uses the
# `environment.ts` files instead.
#
# None of these is a secret: everything below is delivered to the browser in plain text.
# A public OIDC client has no client secret, and if you find yourself wanting to put one
# here, the flow is wrong rather than the file.
# -----------------------------------------------------------------------------

# REQUIRED for the container. `dev` | `oidc`.
# `dev` renders the built-in role picker and contacts no identity provider — local and
# demo use only. `oidc` authenticates against a real authority and requires the three
# values below.
AUTH_MODE=dev

# REQUIRED when AUTH_MODE=oidc.
OIDC_CLIENT_ID=<your-public-spa-client-id>
OIDC_AUTHORITY=<https://keycloak.example.com/realms/your-realm>
OIDC_SCOPE=<openid profile email>


# -----------------------------------------------------------------------------
# 10. LOCAL DEVELOPER TOOLING
#
# Read by the hooks in `.claude/hooks/`, not by the application. In CI the SonarQube
# values come from repository variables and secrets instead — see README.md.
# -----------------------------------------------------------------------------

# REQUIRED for the local `sonar-pre-push` gate, which FAILS CLOSED: with these unset the
# hook blocks the push and tells you why, rather than passing silently.
SONAR_HOST_URL=<http://localhost:9000>
# SECRET. A SonarQube analysis or user token.
SONAR_TOKEN=
# OPTIONAL. Falls back to `sonar.projectKey` in `sonar-project.properties`.
SONAR_PROJECT_KEY=

# OPTIONAL. `1` runs a full scan before querying the gate. Slow; off by default.
SONAR_RUN_SCAN=0

# OPTIONAL, AND PAID-EDITION ONLY. Leave unset on SonarQube Community Build, which
# analyses exactly one branch. Setting it there makes the gate fail closed.
# SONAR_BRANCH=

# ESCAPE HATCHES. All three default to off. Each one turns a gate off, so each one is a
# decision someone has to own; none is a developer convenience.
#   SONAR_GATE_SKIP=1     bypasses the SonarQube gate. Tech-lead decision. Code pushed
#                         under it has NOT been analysed and must be scanned before merge.
#   COMMIT_MSG_SKIP=1     bypasses the Conventional Commits check in
#                         `.claude/hooks/commit-msg.sh`. For an automated merge or revert
#                         commit whose message you do not control.
# SONAR_GATE_SKIP=0
# COMMIT_MSG_SKIP=0
