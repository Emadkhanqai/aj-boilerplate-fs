.sonarqube/
.sonar/
.scannerwork/
*.sarif

# ---- Node / Nx / Angular ----
node_modules/
dist/
dist-ssr/
tmp/
out-tsc/
.angular/
.nx/
.nx/cache
.nx/workspace-data
.vite/
vite.config.*.timestamp*
vitest.config.*.timestamp*
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ---- Test output (frontend) ----
test-results/
playwright-report/
playwright/.cache/
blob-report/
.playwright/
.playwright-mcp/

# ---- Infrastructure as code ----
# Terraform state, plans, and provider binaries are never committed.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Real variable values are environment-specific and often sensitive.
*.tfvars
*.tfvars.json
!*.tfvars.example
# Bicep parameter files with real values.
*.parameters.json
!*.parameters.example.json

# ---- IDEs and editors ----
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
# `!.vscode/` comes FIRST and is load-bearing. Excluding a directory stops git descending
# into it at all, and a file inside an excluded directory cannot be re-included — so if
# anything excludes `.vscode/` itself, the four negations below never get a chance to
# match. A global ignore file (`core.excludesFile`, commonly `~/.gitignore_global`) very
# often contains exactly that line, which silently hides the committed workspace settings
# on that developer's machine and nowhere else. A repository `.gitignore` outranks the
# global one, so re-including the directory here fixes it for everyone.
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Explicitly tracked artefacts (do NOT ignore) ----
# EF Core migrations, the generated OpenAPI client types, and session handoffs are
# source-controlled deliverables. These negations exist so a broader rule above can
# never accidentally swallow them.
!src/backend/src/*/Migrations/
!src/frontend/libs/data-access/api-types/src/
!docs/handoff/
